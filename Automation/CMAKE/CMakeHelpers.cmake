macro(system_info)
    message("=================== System info ===================")
    message("System: ${CMAKE_SYSTEM_NAME}")
    message("Compiler: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
    if(MSVC)
        message("MSVC toolset version: ${MSVC_TOOLSET_VERSION}")
    endif()
    message("Configuration types: ${CMAKE_CONFIGURATION_TYPES}")
    message("===================================================")
endmacro()
